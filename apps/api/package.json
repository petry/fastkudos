{
  "name": "@fastkudos/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy:worker": "wrangler deploy",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.dev.vars scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.dev.vars scripts/seed.ts"
  },
  "dependencies": {
    "@fastkudos/shared": "workspace:*",
    "@neondatabase/serverless": "^0.10.1",
    "arctic": "^3.7.0",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260507.0",
    "@eslint/js": "^9.13.0",
    "@testcontainers/postgresql": "^10.13.2",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.28.0",
    "eslint": "^9.13.0",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.2",
    "vitest": "^2.1.4",
    "wrangler": "^4.90.0"
  }
}
